{
  "name": "lifedb",
  "version": "0.1.0",
  "description": "LifeDB — Decentralized-hybrid medical database system",
  "main": "dist/api/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/api/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/api/server.ts",
    "mongo:sharded:init": "powershell -ExecutionPolicy Bypass -File scripts/init-mongo-sharded.ps1 -StartStack",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "experiments:all": "ts-node --project tsconfig.json scripts/run_experiments.ts",
    "lint": "eslint src --ext .ts",
    "purechain:compile": "hardhat compile",
    "purechain:deploy": "hardhat run scripts/deploy-purechain.js --network purechain",
    "purechain:anchor": "hardhat run scripts/anchor-chain-purechain.js --network purechain",
    "purechain:benchmark": "node scripts/benchmark-purechain.js",
    "anchor:benchmark:comparator": "node scripts/benchmark-anchor-comparator.js",
    "purechain:test-auto-anchor": "node scripts/test-auto-anchor.js",
    "supplychain:deploy": "npx hardhat run scripts/deploy-supplychain.js --network purechain",
    "supplychain:benchmark": "node scripts/benchmark-supplychain.js",
    "supplychain:benchmark:suite": "node scripts/run-supplychain-benchmark-suite.js",
    "supplychain:benchmark:q1": "node scripts/run-supplychain-benchmark-q1.js",
    "supplychain:benchmark:extended": "node scripts/run-supplychain-benchmark-extended.js",
    "supplychain:benchmark:distributed": "node scripts/benchmark-supplychain-distributed.js",
    "supplychain:benchmark:distributed-validation": "node scripts/benchmark-distributed-validation.js",
    "supplychain:benchmark:distributed-validation:wan": "node scripts/benchmark-distributed-validation-wan.js",
    "supplychain:benchmark:search-scaling": "node scripts/benchmark-search-scaling.js",
    "supplychain:benchmark:anchor-queue": "node scripts/benchmark-anchor-queue.js",
    "supplychain:benchmark:anchor-adaptive": "node scripts/benchmark-adaptive-anchor.js",
    "supplychain:benchmark:recovery": "node scripts/benchmark-failure-recovery.js",
    "supplychain:benchmark:topologies": "node scripts/benchmark-mongo-topologies.js",
    "supplychain:baseline:search": "node scripts/benchmark-supplychain-baselines.js",
    "healthcare:prepare": "node scripts/prepare-healthcare-datasets.js",
    "healthcare:keywords": "node scripts/prepare-healthcare-keywords.js",
    "healthcare:index": "node scripts/prepare-healthcare-inverted-index.js",
    "healthcare:workloads": "node scripts/prepare-healthcare-query-workloads.js",
    "privsearch:benchmark": "node scripts/benchmark-privsearch-workloads.js",
    "privsearch:benchmark:prototype": "node -e \"process.env.PRIVSEARCH_ENGINE='privsearch-prototype'; require('./scripts/benchmark-privsearch-workloads.js')\"",
    "privsearch:benchmark:prototype:healthcare": "node -e \"process.env.PRIVSEARCH_DATASET='healthcare'; process.env.PRIVSEARCH_ENGINE='privsearch-prototype'; require('./scripts/benchmark-privsearch-workloads.js')\"",
    "privsearch:benchmark:ablation": "node scripts/benchmark-privsearch-ablation.js",
    "privsearch:benchmark:scalability": "node scripts/benchmark-privsearch-scalability.js",
    "privsearch:benchmark:resources": "node scripts/benchmark-privsearch-resource-overhead.js",
    "privsearch:benchmark:seacq": "node scripts/run-seacq-comparison.js",
    "privsearch:benchmark:seacq:headtohead": "node scripts/benchmark-seacq-headtohead.js",
    "privsearch:benchmark:seacq:headtohead:healthcare": "cross-env H2H_DATASET=healthcare node scripts/benchmark-seacq-headtohead.js",
    "privsearch:benchmark:seacq:sweep": "node scripts/benchmark-seacq-sample-sweep.js",
    "privsearch:benchmark:seacq:sweep:healthcare": "cross-env H2H_DATASET=healthcare node scripts/benchmark-seacq-sample-sweep.js",
    "privsearch:benchmark:tamper": "node scripts/benchmark-tamper-injection.js",
    "privsearch:benchmark:tamper:small": "node scripts/benchmark-tamper-small-extra.js",
    "privsearch:generate:healthcare:and": "node scripts/generate-healthcare-and-workloads.js",
    "privsearch:benchmark:ablation:live": "cross-env PRIVSEARCH_ABLATION_TRIALS=25 node scripts/benchmark-privsearch-ablation.js",
    "privsearch:benchmark:replay": "node scripts/benchmark-replay-protection.js",
    "privsearch:analyze:phases": "node scripts/analyze-privsearch-phase-breakdown.js",
    "privsearch:analyze:crypto": "node scripts/analyze-privsearch-crypto-overhead.js",
    "privsearch:analyze:stats": "node scripts/generate-privsearch-statistical-rigor.js",
    "privsearch:paper:assets": "node scripts/generate-privsearch-paper-assets.js",
    "privsearch:paper:assets:healthcare": "node scripts/generate-privsearch-healthcare-assets.js",
    "privsearch:paper:tables:final": "node scripts/generate-final-privsearch-journal-tables.js",
    "privsearch:benchmark:seacq:fill": "node scripts/fill-seacq-published-columns.js",
    "privsearch:benchmark:seacq:style-figure": "python scripts/generate-seacq-style-figure.py",
    "ipfs:test": "node scripts/test-ipfs-integration.js",
    "bench:storage": "node scripts/benchmark-storage-matrix.js",
    "bench:storage:aggregate": "node scripts/aggregate-storage-matrix.js",
    "paper:assets": "node scripts/generate-paper-assets.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "ethers": "^6.13.5",
    "express": "^4.18.3",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "minio": "^7.1.3",
    "mongodb": "^6.5.0",
    "uuid": "^9.0.1",
    "winston": "^3.12.0",
    "ws": "^8.16.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^3.0.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.11.30",
    "@types/supertest": "^7.2.0",
    "@types/uuid": "^9.0.8",
    "@types/ws": "^8.5.10",
    "hardhat": "^2.22.19",
    "jest": "^29.7.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.1.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.ts"
    ],
    "globals": {
      "ts-jest": {
        "tsconfig": {
          "strict": false
        }
      }
    }
  }
}
